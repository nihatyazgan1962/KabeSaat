<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top: Header with Icon & City -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="4dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Kabe" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="KÂBE SAAT"
            android:textColor="#FFD700"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_bg"
            android:paddingStart="6dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1dp"
            android:text="İstanbul"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Section: Next Prayer & Big Time (Dar & Kompakt) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/widget_next_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AKŞAM VAKTİ"
            android:textColor="#FFD700"
            android:textSize="10sp"
            android:letterSpacing="0.06"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18:04"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kalan: 01:25:40"
            android:textColor="#00FF88"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom: Narrow 2-Column Summary Table -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_time_imsak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="İmsak 06:05"
                android:textColor="#DDDDDD"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_time_ogle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Öğle 12:53"
                android:textColor="#DDDDDD"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="1dp">

            <TextView
                android:id="@+id/widget_time_ikindi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="İkindi 15:47"
                android:textColor="#DDDDDD"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_time_aksam"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Akşam 18:04"
                android:textColor="#FFD700"
                android:textStyle="bold"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_time_yatsi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Yatsı 19:26"
                android:textColor="#DDDDDD"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
